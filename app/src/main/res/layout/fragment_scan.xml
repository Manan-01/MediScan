<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mt_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/modeTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            app:tabIndicatorColor="@color/mt_coral"
            app:tabSelectedTextColor="@color/mt_teal_dark"
            app:tabTextColor="@color/mt_muted"
            android:layout_marginBottom="8dp">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Text Scan" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barcode Scan" />
        </com.google.android.material.tabs.TabLayout>

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mt_muted"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"/>

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/mt_teal"
            android:textColor="#FFFFFF"
            android:text="Scan Medicine"
            android:layout_marginBottom="16dp"/>

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:visibility="visible"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Medicine Name"
                    android:textColor="@color/mt_muted"
                    android:textSize="13sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible"/>

                <Button
                    android:id="@+id/btnConfirmName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirm name"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/tvNameStatus"
                    android:textColor="@color/mt_teal"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvRescanName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not correct? Tap to rescan"
                    android:textColor="@color/mt_coral"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Expiry Date"
                    android:textColor="@color/mt_muted"
                    android:textSize="13sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <EditText
                    android:id="@+id/etExpiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible"/>

                <Button
                    android:id="@+id/btnConfirmExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirm expiry"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/tvExpiryStatus"
                    android:textColor="@color/mt_teal"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvRescanExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not correct? Tap to rescan"
                    android:textColor="@color/mt_coral"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/mt_coral"
            android:textColor="#FFFFFF"
            android:text="Save Medicine"
            android:visibility="gone"
            android:enabled="false"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mt_muted"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:text="Raw scan output will appear here for debugging"
            />

    </LinearLayout>
</ScrollView>